# Praxis Platform Backend Environment Variables

# Environment & Server
ENVIRONMENT=development
ENV=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://praxis-frontend-r4tp.onrender.com

# Authentication & Security (Local JWT & Demo Accounts)
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-prod
JWT_EXPIRE_HOURS=168
ENABLE_DEMO_ACCOUNTS=true

# Clerk Authentication (FAANG-Grade Clerk Backend Integration)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# AI & LLM Providers (Optional)
GEMINI_API_KEY=
